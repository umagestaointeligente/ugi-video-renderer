{
  "schema": "VSA_EDITORIAL_GUARDRAILS_V2",
  "status": "CANONICAL_ACTIVE",
  "topic_repeat_lock": {
    "window_days": 60,
    "match_level": "semantic_topic_core",
    "required_classification": ["NEW_TOPIC", "REPEAT_BLOCKED", "BREAKING_EXCEPTION"],
    "default_on_match": "BLOCK",
    "breaking_exception": {
      "allowed": true,
      "requires_material_new_fact": true,
      "allowed_reasons": ["new_major_event", "new_case", "new_discovery", "new_consequence", "material_update"],
      "required_manifest_fields": ["previous_topic", "previous_date", "new_fact", "current_source", "exception_reason"],
      "performance_alone_is_not_exception": true
    }
  },
  "daily_editorial_mix": {
    "status": "CANONICAL_DEFAULT",
    "daily_target_videos": 8,
    "default_split": {
      "WORLD_SCIENCE": 4,
      "PEOPLE_CURIOSITY": 4
    },
    "world_science_scope": [
      "science",
      "nature_phenomena",
      "technology",
      "space",
      "climate",
      "discoveries",
      "engineering",
      "human_body_when_explanatory",
      "relevant_current_events_with_explainable_mechanism"
    ],
    "people_curiosity_scope": [
      "influencers",
      "public_figures",
      "human_curiosities",
      "historical_people",
      "behavior",
      "remarkable_human_events",
      "general_curiosities_not_required_to_be_science_based"
    ],
    "editorial_bucket_required": true,
    "allowed_editorial_buckets": ["WORLD_SCIENCE", "PEOPLE_CURIOSITY"],
    "temporary_quality_exception": {
      "allowed": true,
      "allowed_splits": ["5/3", "3/5"],
      "only_when_blocked_by": ["rights", "real_footage", "topic_repeat_60d", "quality_gate"],
      "quality_over_volume": true,
      "return_to_4_4_next_cycle": true
    },
    "identity_rule": "Daily VSA programming should combine explanation of the world with human curiosity; do not let the channel become only science news or only celebrity content."
  },
  "real_footage_alternation": {
    "status": "HARD_GATE",
    "observable_real_world_topic_requires_real_footage": true,
    "minimum_real_footage_blocks": 3,
    "minimum_distinct_real_clips_or_angles": 2,
    "required_sequence": ["REAL_1", "EXPLANATION", "REAL_2_DIFFERENT", "EXPLANATION", "REAL_3_OR_CONSEQUENCE", "PAYOFF", "CTA"],
    "same_take_reused_as_new_evidence": "FAIL",
    "animation_may_replace_observable_subject_for_convenience": false,
    "not_applicable_requires_reason": true,
    "insufficient_rights_safe_footage_result": "BLOCK_REAL_FOOTAGE",
    "release_gate": "real_footage_gate=PASS"
  },
  "longform_policy": {
    "status": "HARD_GATE",
    "applies_to": "VSA_LONGFORM",
    "real_footage_first": true,
    "real_footage_rule": "Whenever the narration refers to an observable real event, object, person, launch, spacecraft, experiment, component, test or consequence, show authentic rights-safe footage or imagery of that subject when available. Use animation for invisible mechanisms, trajectories, scale, fields, internal processes or transitions that cannot be shown directly.",
    "required_visual_alternation": ["REAL_FOOTAGE", "EXPLANATION_OR_CAUSAL_ANIMATION", "DIFFERENT_REAL_FOOTAGE", "EXPLANATION_OR_DATA", "REAL_EVIDENCE_OR_CONSEQUENCE"],
    "retention_arc_required": true,
    "retention_arc": ["HIGH_IMPACT_HOOK", "STAKES", "PROBLEM", "REVEAL_1", "NEW_PROBLEM", "REVEAL_2", "REAL_PROOF", "SCIENTIFIC_PAYOFF", "FINAL_TWIST_OR_CURRENT_UPDATE", "SHORT_CTA"],
    "pacing_rule": "The story must continuously evolve. Avoid long flat explanation blocks, repeated visual families, static exposition and narration that resolves the central question too early. Introduce a new question, risk, reveal, visual proof or consequence before attention stalls.",
    "visual_change_guidance_seconds": [3, 5],
    "visual_change_is_guidance_not_mechanical_cutting": true,
    "voice": {
      "language": "pt-BR",
      "gender": "male",
      "native_brazilian_portuguese_required": true,
      "neutral_accent_required": true,
      "marked_foreign_or_european_portuguese_accent": "FAIL",
      "natural_pleasant_delivery_required": true,
      "robotic_or_advertising_delivery": "FAIL",
      "preferred_reuse": "Reuse the validated VSA Shorts voice when available; otherwise a new longform voice must pass a listening gate before publication."
    },
    "release_gates": ["LONGFORM_REAL_FOOTAGE_PASS", "LONGFORM_RETENTION_PASS", "VOICE_PTBR_NEUTRAL_PASS"]
  },
  "people_biocuriosity": {
    "enabled": true,
    "content_class": "PERSON_PROFILE",
    "real_person_reference_required": true,
    "real_person_video_required": true,
    "minimum_distinct_real_person_video_segments": 2,
    "prohibited_substitutes": ["journalist_as_subject_proxy", "presenter_as_subject_proxy", "generic_stock_person", "unrelated_broll_person"],
    "animation_role": "Explain disease, physiology, mechanism, technology, context or cause while keeping the real person visually anchored.",
    "preferred_sequence": ["REAL_PERSON_VIDEO_1", "CONTEXT_OR_EXPLANATION", "REAL_PERSON_VIDEO_2_DIFFERENT", "EXPLANATION", "REAL_PERSON_OR_EVIDENCE", "CONSEQUENCE", "PAYOFF"],
    "health_rule": "Separate documented facts from inference; do not diagnose beyond reliable sources.",
    "release_gate": "person_visual_reference_gate=PASS and person_real_video_segments_gate=PASS"
  },
  "job_requirements": {
    "topic_history_gate": "PASS",
    "editorial_bucket": ["WORLD_SCIENCE", "PEOPLE_CURIOSITY"],
    "real_footage_gate_when_required": "PASS",
    "longform_real_footage_gate_when_longform": "PASS",
    "longform_retention_gate_when_longform": "PASS",
    "voice_ptbr_neutral_gate_when_longform": "PASS",
    "person_visual_reference_gate_when_person_profile": "PASS",
    "person_real_video_segments_gate_when_person_profile": "PASS"
  }
}
