{
  "schema_version": "1.5",
  "effective_date": "2026-09-04",
  "project": "UGI",
  "distribution_state_ref": "config/ugi/distribution-state.json",
  "buffer_budget_policy_ref": "config/ugi/buffer-budget-policy.json",
  "control_plane": {
    "canonical_publication_hub": "UGI Publisher Hub",
    "queue_path": "control-plane/publisher-hub/queue",
    "render_state_path": "control-plane/publisher-hub/render-state",
    "receipt_path": "control-plane/publisher-hub/receipts",
    "status_path": "control-plane/publisher-hub/status/latest.json",
    "buffer_budget_policy_path": "config/ugi/buffer-budget-policy.json",
    "buffer_circuit_path": "control-plane/observability/buffer-circuit.json",
    "chat_runtime_required": false,
    "canonical_flow": [
      "publisher_hub_queue",
      "worker_video_render",
      "editorial_draft",
      "r2_platform_assets",
      "platform_approval",
      "publication_eligibility",
      "buffer_budget_guard",
      "buffer_schedule",
      "buffer_readback",
      "publisher_hub_receipt"
    ],
    "linkedin_editorial_adapter": {
      "status": "ACTIVE",
      "queue_path": "control-plane/publisher-hub/linkedin-queue",
      "status_path": "control-plane/publisher-hub/linkedin-status/latest.json",
      "workflow": ".github/workflows/ugi-linkedin-publisher.yml",
      "runtime": "scripts/ugi_linkedin_publisher.py",
      "worker_create_route": "/api/linkedin-text-publish",
      "worker_readback_route": "/api/linkedin-publication-status",
      "current_supported_formats": ["text"],
      "unsupported_format_policy": "FAIL_CLOSED",
      "exactly_once_create": true,
      "buffer_post_id_persisted_before_readback": true,
      "max_buffer_calls_per_run": 1,
      "rate_limit_circuit_path": "control-plane/observability/buffer-circuit.json",
      "rate_limit_cooldown_hours": 6,
      "company_page_only": true
    },
    "render_bridge": {
      "authority": "UGI Worker /api/video-render",
      "direct_github_renderer_dispatch_allowed": false,
      "approval_draft_id_required": true,
      "render_state_persisted": true
    },
    "legacy_chat_publication_path": {
      "path": "control-plane/chat-publication",
      "status": "compatibility_only",
      "mutates_publication": false,
      "forward_target": "UGI Publisher Hub"
    },
    "legacy_chat_render_control_plane": {
      "workflow": ".github/workflows/ugi-chat-control-plane.yml",
      "status": "compatibility_only",
      "direct_render_dispatch": false,
      "forward_target": "UGI Publisher Hub"
    }
  },
  "routing_policy": {
    "publishing": {
      "provider": "buffer",
      "exclusive": true,
      "orchestrator": "UGI Publisher Hub",
      "active_platforms": ["linkedin", "instagram", "tiktok"],
      "paused_platforms": ["youtube"],
      "allowed_operations": [
        "schedule",
        "queue",
        "publish",
        "retry",
        "publication_status",
        "publication_readback"
      ],
      "fallback_provider": null,
      "fail_closed_if_unavailable": true,
      "rate_limit_policy": {
        "provider_window": "24h",
        "circuit_breaker": true,
        "probe_cooldown_hours": 6,
        "no_busy_polling": true,
        "quota_probe_calls": 0,
        "one_recovery_canary_after_cooldown": true,
        "recovery_canary_max_buffer_calls": 1,
        "publication_reserve_required": true,
        "buffer_budget_policy_path": "config/ugi/buffer-budget-policy.json",
        "one_buffer_backed_call_per_linkedin_run": true
      },
      "linkedin_target": {
        "type": "LinkedIn Page",
        "page_name": "UGI — Uma Gestão Inteligente",
        "buffer_name": "uma-gestao-inteligente",
        "personal_profile_target_allowed": false,
        "queue_required_for_editorials": true
      },
      "youtube": {
        "buffer_status": "PAUSED",
        "strategy_abandoned": false,
        "buffer_mutation_allowed": false
      }
    },
    "analytics": {
      "provider": "metricool",
      "read_only": true,
      "allowed_operations": [
        "analytics_read",
        "best_time_read",
        "performance_read",
        "historical_analysis"
      ],
      "forbidden_operations": [
        "create_post",
        "update_post",
        "schedule_post",
        "reschedule_post",
        "queue_post",
        "publish_post",
        "retry_publication"
      ]
    },
    "native_platforms": {
      "role": "verification_and_supplemental_analytics",
      "publishing_default": false
    }
  },
  "hard_invariants": [
    "Metricool must never mutate the UGI publishing plan.",
    "Metricool must never be used as fallback publisher.",
    "Buffer is the sole official scheduler and publisher for active UGI Buffer channels.",
    "UGI Publisher Hub is the sole canonical render and publication orchestrator.",
    "Production video renders must enter through Worker /api/video-render so approvalDraftId is persisted before media upload.",
    "Direct production dispatch from legacy chat control planes to render-video.yml is forbidden.",
    "Chat runtimes, including Lola 5.3, are optional command clients and are never required for render, scheduling or publication.",
    "If Buffer publication cannot be proven by readback, status is BLOCKED, WAITING or NOT_PROVEN.",
    "LinkedIn publication must target only UGI — Uma Gestão Inteligente Company Page and never Paulo Oliveira's personal profile.",
    "Every future LinkedIn editorial must enter the canonical LinkedIn queue before Buffer mutation.",
    "A LinkedIn Buffer Post ID must be persisted before any readback retry so create is exactly-once.",
    "A rate-limit response opens the Buffer circuit; busy polling is forbidden while the circuit is open.",
    "No Buffer call may exist only to check whether quota remains.",
    "While the Buffer circuit is OPEN before nextProbeAt, Buffer mutations and Buffer-backed readbacks are forbidden and consume zero Buffer calls.",
    "After nextProbeAt, recovery begins with one Buffer-backed canary only; normal mutation resumes only after that canary proves recovery.",
    "PROVEN_PUBLISHED or DELIVERED requires live Buffer readback evidence, never only a local receipt.",
    "YouTube Buffer status is PAUSED; no new Buffer mutation may target YouTube while paused.",
    "YouTube strategy, content and history remain preserved for future evidence-based reactivation.",
    "Any migration away from Buffer requires an explicit ADR, smoke test, rollback plan and policy update before production use."
  ]
}
